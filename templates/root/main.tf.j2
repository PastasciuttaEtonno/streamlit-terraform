# main.tf

# 1. Modulo Network
module "network" {
  source = "./modules/network"

  environment_name     = "{{ project_name }}"
  vpc_cidr             = "{{ network.vpc_cidr }}"
  
  # Nuovi parametri dinamici
  az_count             = {{ network.az_count }}
  public_subnet_count  = {{ network.public_subnet_count }}
  private_subnet_count = {{ network.private_subnet_count }}
}

# 2. Modulo EC2
module "ec2" {
  source = "./modules/ec2"

  environment_name = "{{ project_name }}"
  vpc_id           = module.network.vpc_id
  
  # Logica subnet (uguale a prima)
  {% if ec2.subnet_type == 'private' %}
  subnet_id           = module.network.private_subnet_ids[0]
  associate_public_ip = false
  {% else %}
  subnet_id           = module.network.public_subnet_ids[0]
  associate_public_ip = true
  {% endif %}

  ami_id          = "{{ ec2.ami_id }}"
  instance_type   = "{{ ec2.instance_type }}"
  instance_count  = {{ ec2.instance_count }}

  key_name         = "{{ ec2.key_name }}"

  # Nuova logica rules
  security_group_rules = [
    {% for rule in ec2.security_group_rules %}
    {
      direction   = "{{ rule.direction }}"
      from_port   = {{ rule.from_port }}
      to_port     = {{ rule.to_port }}
      protocol    = "{{ rule.protocol }}"
      cidr_blocks = [{% for cidr in rule.cidr_blocks %}"{{ cidr }}"{% if not loop.last %}, {% endif %}{% endfor %}]
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
  
  disk_size        = {{ ec2.disk_size }}
  disk_type        = "{{ ec2.disk_type }}"
  
  # Per lo user data usiamo un blocco "Heredoc" per evitare problemi con "a capo"
  # EOF permette di passare testo multilinea pulito
  user_data_script = <<EOF
{{ ec2.user_data_script }}
EOF
}

# 3. Modulo ALB (Opzionale)
{% if alb.enabled %}
module "alb" {
  source = "./modules/alb"

  environment_name    = "{{ project_name }}"
  vpc_id              = module.network.vpc_id
  public_subnet_ids   = module.network.public_subnet_ids
  target_instance_ids = module.ec2.instance_ids
  ingress_port        = {{ alb.ingress_port }}

  # --- NUOVI PARAMETRI ROUTING ---
  listener_action_type = "{{ alb.action_type }}"
  
  # Passiamo i valori condizionali (Jinja li riempie sempre, ma Terraform usa solo quelli che servono)
  redirect_protocol    = "{{ alb.redirect_protocol }}"
  redirect_port        = "{{ alb.redirect_port }}"
  redirect_status_code = "{{ alb.redirect_status_code }}"
  
  fixed_response_body         = "{{ alb.fixed_response_body }}"
  fixed_response_code         = "{{ alb.fixed_response_code }}"
  fixed_response_content_type = "{{ alb.fixed_response_content_type }}"
}
{% endif %}

# 4. SICUREZZA AVANZATA: EC2 accetta HTTP solo dall'ALB
# Questa regola viene creata SOLO se l'ALB è abilitato.
{% if alb.enabled %}
resource "aws_security_group_rule" "allow_alb_to_ec2" {
  type                     = "ingress"
  from_port                = {{ alb.ingress_port }}
  to_port                  = 80 # Porta interna dell'app (es. Nginx)
  protocol                 = "tcp"
  
  # DOVE applichiamo la regola? Al Security Group delle EC2
  security_group_id        = module.ec2.security_group_id
  
  # CHI può entrare? Solo il Security Group dell'ALB
  source_security_group_id = module.alb.security_group_id
}
{% endif %}

# 5. Modulo Database (Opzionale)
{% if rds.enabled %}
module "rds" {
  source = "./modules/rds"

  environment_name    = "{{ project_name }}"
  vpc_id              = module.network.vpc_id
  private_subnet_ids  = module.network.private_subnet_ids
  
  # PASSAGGIO CRITICO PER LA SICUREZZA
  ec2_security_group_id = module.ec2.security_group_id

  identifier          = "{{ rds.identifier }}"
  engine              = "{{ rds.engine }}"
  instance_class      = "{{ rds.instance_class }}"
  allocated_storage   = {{ rds.allocated_storage }}
  db_name             = "{{ rds.db_name }}"
  username            = "{{ rds.username }}"
  password            = "{{ rds.password }}"
}
{% endif %}